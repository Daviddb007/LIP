# ============================================
# V2 App
# ============================================
FLASK_CONFIG=production
SECRET_KEY=your-secret-key-64-chars-minimum
DATABASE_URL=postgresql://construyamos:db-password@db:5432/construyamos_colombia
ADMIN_USER=admin
ADMIN_PASS=your-admin-password-hash

# ============================================
# V3 App (main)
# ============================================
SECRET_KEY_V3=your-v3-secret-key-64-chars-minimum
DB_USER_V3=construyamos_v3
DB_PASSWORD_V3=your-v3-db-password
DB_NAME_V3=construyamos_v3
ADMIN_API_TOKEN=your-admin-api-token-for-api-v1

# ============================================
# Shared
# ============================================
RATELIMIT_STORAGE_URI=redis://redis:6379/0
CACHE_TYPE=RedisCache
CACHE_REDIS_URL=redis://redis:6379/1
LOG_LEVEL=info

# ============================================
# Fase "Estrategia de participación robusta"
# ============================================
# Almacenamiento reservado (volumen docker)
UPLOADS_DIR=/app/uploads
UPLOAD_MAX_MB=500
RQ_CONNECTION_URI=redis://redis:6379/2

# Transcripción local (reserva total: los audios no salen del servidor)
WHISPER_MODEL=small
# Opciones GPU: WHISPER_DEVICE=cuda WHISPER_COMPUTE_TYPE=float16

# Análisis semántico (SOLO texto) — gemini | openai | ninguno
LLM_PROVIDER=ninguno
LLM_API_KEY=
LLM_MODEL=
