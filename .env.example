FLASK_CONFIG=development
SECRET_KEY=change-me-to-a-random-secret-string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/construyamos_colombia
ADMIN_USER=admin
# Use hashed password: python generate_password.py <your-password>
ADMIN_PASS=change-me-to-a-strong-password

# Production only
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# CACHE_REDIS_URL=redis://localhost:6379/1
# PORT=8000
# LOG_LEVEL=info

# ---- Fase "Estrategia de participación robusta" (grupos focales) ----
# Almacenamiento reservado (fuera del web root)
UPLOADS_DIR=uploads
UPLOAD_MAX_MB=500

# Cola de trabajos (RQ usa Redis)
RQ_CONNECTION_URI=redis://localhost:6379/2

# Transcripción local (faster-whisper) — los audios nunca salen del servidor
WHISPER_MODEL=small

# Proveedor LLM para análisis SEMÁNTICO (solo texto, nunca audio)
# Valores: gemini | openai | ninguno
LLM_PROVIDER=ninguno
LLM_API_KEY=
LLM_MODEL=
